generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Grupo {
  id         String   @id @default(uuid())
  nome       String
  quantidade Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum StatusTerreno {
  DISPONIVEL
  OCUPADO
  EM_DESCANSO
}

model Terreno {
  id              String        @id @default(uuid())
  nome            String
  periodoDescanso Int
  status          StatusTerreno @default(DISPONIVEL)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("terrenos")
}
